{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://twinscript.local/contracts/local-inference/protocol-v1.schema.json",
  "title": "TwinScript Local Inference Protocol v1",
  "type": "object",
  "required": ["protocolVersion", "type", "requestId", "sessionId"],
  "properties": {
    "protocolVersion": { "const": 1 },
    "type": {
      "enum": [
        "hello", "capabilities", "model.prepare", "model.ready",
        "asr.start", "asr.audio", "asr.flush", "asr.stop", "asr.result",
        "translate.preview", "translate.final", "translate.result",
        "request.cancel", "health", "error", "shutdown"
      ]
    },
    "requestId": { "type": "string", "minLength": 1, "maxLength": 128 },
    "sessionId": { "type": "string", "minLength": 1, "maxLength": 128 },
    "channel": { "enum": ["microphone", "system"] },
    "encoding": { "const": "pcm_s16le" },
    "sampleRate": { "const": 24000 },
    "capturedAt": { "type": "number" },
    "audio": { "type": "string", "maxLength": 640000 },
    "utteranceId": { "type": "string", "minLength": 1, "maxLength": 128 },
    "sourceRevision": { "type": "integer", "minimum": 0 },
    "sourceLanguage": { "type": "string", "minLength": 1, "maxLength": 64 },
    "targetLanguage": { "type": "string", "minLength": 1, "maxLength": 64 },
    "text": { "type": "string" },
    "final": { "type": "boolean" },
    "model": { "type": "string", "minLength": 1 },
    "runtime": { "type": "string", "minLength": 1 },
    "requestedDevice": { "enum": ["NPU", "GPU", "CPU"] },
    "actualDevice": { "enum": ["NPU", "GPU", "CPU"] },
    "inferenceMs": { "type": "number", "minimum": 0 },
    "generation": { "type": "integer", "minimum": 1 },
    "code": { "type": "string", "minLength": 1 },
    "message": { "type": "string", "minLength": 1 }
  },
  "allOf": [
    {
      "if": { "properties": { "type": { "const": "asr.audio" } } },
      "then": { "required": ["channel", "encoding", "sampleRate", "capturedAt", "audio"] }
    },
    {
      "if": { "properties": { "type": { "enum": ["translate.preview", "translate.final"] } } },
      "then": { "required": ["utteranceId", "sourceRevision", "sourceLanguage", "targetLanguage", "text"] }
    },
    {
      "if": { "properties": { "type": { "const": "asr.result" } } },
      "then": {
        "required": ["channel", "utteranceId", "text", "final", "model", "runtime", "requestedDevice", "actualDevice", "inferenceMs"]
      }
    },
    {
      "if": { "properties": { "type": { "const": "translate.result" } } },
      "then": {
        "required": ["utteranceId", "sourceRevision", "text", "model", "runtime", "requestedDevice", "actualDevice", "inferenceMs"]
      }
    },
    {
      "if": { "properties": { "type": { "const": "request.cancel" } } },
      "then": { "required": ["requestId"] }
    },
    {
      "if": { "properties": { "type": { "const": "error" } } },
      "then": { "required": ["code", "message"] }
    }
  ],
  "additionalProperties": true
}
